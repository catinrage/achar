{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,
    "baseUrl": ".",
    "paths": {
      "@achar/core": ["./packages/core/src/index.ts"],
      "@achar/core/*": ["./packages/core/src/*"],
      "@achar/mcp": ["./packages/mcp/src/server.ts"],
      "@achar/mcp/*": ["./packages/mcp/src/*"],
      "@achar/server": ["./packages/server/src/server.ts"],
      "@achar/server/*": ["./packages/server/src/*"],
      "$src/*": ["./packages/core/src/*"],
      "$common/*": ["./packages/core/src/common/*"],
      "$types": ["./packages/core/src/types.ts"]
    }
  }
}
