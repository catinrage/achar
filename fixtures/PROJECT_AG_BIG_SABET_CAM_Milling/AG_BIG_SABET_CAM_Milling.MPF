                    ..> x = cosy*cosz*x - sinz*cosy*y + siny*z
                    ..> y = (-sinx*siny*cosz + cosx*sinz)*x + (sinx*siny*sinz + cosx*cosz)*y - sinx*cosy*z
                    ..> z = (cosx*cosz*siny + sinx*sinz)*x + (-sinz*cosx*siny + sinx*cosz)*y  - cosx*cosy*z
                    ..> around Z
