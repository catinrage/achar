@drill
  drill_upper_z = drill_upper_z - safety
  C83_FDEP = C83_FDEP * tool_diameter
  C83_FDEP = drill_upper_z - C83_FDEP
  C83_MDEP = C83_MDEP * tool_diameter
  ; Handle output for drill cycles
  local logical skipZpos
  skipZpos = false
  if job_type eq '3-d drill' and prev_command eq '@drill_point'
    skipZpos = true
  endif
  if !skipZpos and drill_type ne CYCLE84
    ; for 4-axis drill it kept printing the zpos, because the top if condition never succeeds `job_type eq '3-d drill'`
    ; so i turned if into comments, it seems pointless overall
    ;{nb,cDrZp'Z'zpos' 'cDrZs}
  endif
  if bCoolExist
    call @usr_coolant
  endif
  ; call @usr_bToolPreselect
  if drill_type eq CYCLE84
    {nb, 'S100 M3'}
  endif
endp

;-------------------

@drill_point
  ; Handle output for drill positions
  ; local integer i
  ; if drill_type eq G84_Peck
  ;   iNumpecks = (drill_depth/Q_Peck)+1.
  ;   nCorrectedpeck = drill_depth/iNumpecks
  ;   i = 1
  ;   while i <= iNumpecks
  ;     {nb,'X'xpos ' ', 'Y'ypos ' ', 'Z'(drill_upper_z-(nCorrectedpeck*i))' 'cDrPts}
  ;     i = i + 1
  ;   endw
  ; else
  ;   if !first_drill then
  ;     {nb,['X'xpos ' '], ['Y'ypos ' '], ['Z'zpos ' ']cDrPts}
  ;   endif
  ; endif
  if iNumberOfAixs eq 3
    change(apos) = false
  endif
  {nb, 'G0', [' X'xpos], [' Y'ypos], [' A'apos]}
  {nb, 'F'z_feed}
  if bBrake_On
    Rotclmpunclmp = Rot_Clamp
    if change(Rotclmpunclmp)
      ;{nb, 'M'Rotclmpunclmp}
      ;{nb, 'G4 F8'}
      change(Rotclmpunclmp) = false
    endif
    ;			Rot_Clamp
    ;			Rot_Unclamp
  endif
  if drill_type eq CYCLE81 then
    {nb, 'CYCLE81('job_clearance_plane','drill_upper_z','safety','drill_lower_z',,'C81_DTB',0,1,12)'}
  endif
  if drill_type eq CYCLE83 then
    ; (tool_diameter * C830_FDEP) calc in @drill
    {nb, 'CYCLE83('job_clearance_plane','drill_upper_z','safety','drill_lower_z',,'C83_FDEP',,'C83_DAM','C83_DTB','C83_DTS','C83_FRF','C83_VARI',0,'C83_MDEP','C83_VRT','C83_DTD','C83_DIS1','C83_GMODE',1,12221112)'}
  endif
  if drill_type eq CYCLE830 then
    local integer S_AMODE3 S_AMODE2 Q_AMODE Q_DMODE Q_GMODE Q_VARI
    local integer C830_U_MP C830_U_TSCSF C830_U_Z1 C830_U_D
    C830_U_D = 0
    C830_U_Z1 = 1
    C830_U_TSCSF = 0
    C830_U_MP = 1

    S_AMODE3 = C830_U_ZA + 10 * C830_U_ZP + 100 * C830_U_ZD

    S_AMODE2 = C830_U_F + 10 * C830_U_FA + 100 * C830_U_FP + 1000 * C830_U_FS + 10000 * C830_U_FD + 100000 * C830_U_FR + 1000000 * C830_U_S_V5 + 10000000 * C830_U_SP_V4 + 100000000 * C830_U_SR_V6
    Q_AMODE   = C830_U_Z1 + 10 * C830_U_DTB + 100 * C830_U_DTS + 1000 * C830_U_DT + 10000 * C830_U_D + 100000 * C830_U_DF + 1000000 * C830_U_V3
    Q_DMODE   = C830_U_MP + 10000 * C830_U_TSCSF
    Q_GMODE   = 10 * C830_U_DD_TS
    Q_VARI     = C830_U_MM + 10 * C830_U_RDSR + 100 * C830_U_SFC + 1000 * C830_U_TT + 10000 * C830_U_PP + 100000 * C830_U_RT
    ;{nb, 'M1'}
    {nb,'CYCLE830('job_clearance_plane','drill_upper_z','safety','drill_lower_z','(tool_diameter * C830_FDEP)','C830_DAM','C830_DTB','C830_DTS','C830_FRF','Q_VARI','(tool_diameter * C830_MDEP)','C830_VRT','C830_DTD','C830_DIS1', 'C830_S_FP', 3, 'C830_S_SV2', 'z_feed', 'C830_SDAC', 'spin', 'C830_S_SPOS', '(tool_diameter * C830_S_ZA)', 'C830_S_FA', 'C830_S_ZP', 'C830_S_FS', '(tool_diameter * C830_S_ZS1)','(tool_diameter * C830_S_ZS2)','C830_S_N','C830_S_ZD','C830_S_FD','C830_S_FR','C830_S_SDAC3','C830_S_SV3',"M8","M8",'Q_GMODE','Q_DMODE','Q_AMODE','S_AMODE2','S_AMODE3','C830_S_ZPV')'}
  endif
  ; if drill_type eq CYCLE84 then
  ;   {nb, 'M1'}
  ;   {nb, 'CYCLE84('job_clearance_plane', 'drill_upper_z', 'safety', 'drill_lower_z', , 'C84_DTB', 'C84_SDAC', , 'C84_PIT', 'C84_POSS', 'C84_SST', 'C84_SST1', 'C84_AXN', 'C84_PTAB', 'C84_TECHNO', 'C84_VARI', 'C84_DAM', 'C84_VRT')'}
  ; endif
  if drill_type eq CYCLE84 then
    local integer Q_TECHNO Q_VARI Q_DMODE Q_AMODE
    Q_TECHNO = C84_U_ESR + 10 * C84_U_FC + 100 * C84_U_A + 1000 * C84_U_MSM
    Q_VARI   = C84_U_MT + 10 * C84_U_ISM
    Q_DMODE  = C84_U_MP + 1000 * C84_U_CM + 10000 * C84_U_RS
    Q_AMODE  = C84_U_DD + 1000 * C84_U_TD + 1000000 * C84_U_RD
    ;{nb, 'M1'}
    {nb, 'CYCLE84('job_clearance_plane','drill_upper_z','safety','drill_lower_z','','C84_DTB',3,'','tool_drill_lead','C84_POSS','spin','(spin * C84_SST1)','C84_AXN','C84_PITA','Q_TECHNO','Q_VARI','(tool_drill_lead * C84_DAM)','(tool_drill_lead * C84_VRT)','C84_PITM','C84_PTAB','C84_PTABA','','Q_DMODE','Q_AMODE')'}
  endif
  if drill_type eq CYCLE85 then
    if tool_type eq reamer_mill then
      C85_RFFF = z_feed * C85_RFF
    else
      C85_RFF = 6000
    endif
    ;{nb, 'M1'}
    {nb, 'CYCLE85('job_clearance_plane','drill_upper_z','safety','drill_lower_z',,'C85_DTB','z_feed','C85_RFFF',,1,12)'}
  endif
  if drill_type eq CYCLE86 then
    {nb, 'CYCLE86('job_clearance_plane', 'drill_upper_z', 'safety', 'drill_lower_z', , 'C86_DTB', 'C86_SDIR', 'C86_RPA', 'C86_PRO', 'C86_RPAP', 'C86_POSS')'}
  endif
  if bBrake_On
    Rotclmpunclmp = Rot_Unclamp
    if change(Rotclmpunclmp)
      ;{nb, 'M'Rotclmpunclmp}
      ;{nb, 'G4 F8'}
      change(Rotclmpunclmp) = false
    endif
    ;			Rot_Clamp
    ;			Rot_Unclamp
  endif

endp


