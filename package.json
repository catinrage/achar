{
  "name": "achar",
  "version": "0.1.0",
  "packageManager": "bun@1.3.14",
  "module": "packages/core/src/index.ts",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "exports": {
    ".": "./packages/core/src/index.ts",
    "./posts/siemens-828d": "./packages/core/src/posts/siemens-828d/index.ts"
  },
  "bin": {
    "achar": "packages/cli/src/index.ts"
  },
  "files": [
    "packages/*/package.json",
    "packages/*/src",
    "packages/*/tsconfig.json",
    "packages/desktop/electrobun.config.ts",
    "!packages/**/*.spec.ts",
    "README.md"
  ],
  "scripts": {
    "achar": "bun packages/cli/src/index.ts",
    "achar:mcp": "bun packages/cli/src/index.ts mcp",
    "achar:serve": "bun packages/cli/src/index.ts serve",
    "desktop": "bun run --cwd packages/desktop desktop",
    "desktop:dev": "bun run --cwd packages/desktop desktop:dev",
    "desktop:build": "bun run --cwd packages/desktop desktop:build",
    "desktop:build:windows": "bun scripts/build-windows-desktop.ts",
    "dev": "bun run --watch examples/playground.ts",
    "format-and-lint": "biome check .",
    "format-and-lint:fix": "biome check . --write",
    "test": "bun test --timeout 30000",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  }
}
